FoamFile
{
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    blade
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }

    farfield
    {
        type            calculated;
        value           uniform 0;
    }
}

