FoamFile
{
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    blade
    {
        type            zeroGradient;
    }

    farfield
    {
        type            totalPressure;
        p0              uniform 0;
    }
}

