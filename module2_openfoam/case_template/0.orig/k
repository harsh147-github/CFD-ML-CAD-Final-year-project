/*--------------------------------*- C++ -*----------------------------------*\
| OpenFOAM 12 - fan CFD pipeline (Module 2)                                    |
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

kInlet          0.0024;      // ~ 1.5*(0.05*Utip)^2 ; low freestream turbulence

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform $kInlet;

boundaryField
{
    blade
    {
        type            kqRWallFunction;
        value           uniform $kInlet;
    }

    farfield
    {
        type            inletOutlet;
        inletValue      uniform $kInlet;
        value           uniform $kInlet;
    }
}

// ************************************************************************* //
